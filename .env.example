# Copy to .env and fill in.

# --- Left panel: Krish's Ollama (over the hotspot) ---
# e.g. http://172.20.10.3:11434   (get the IP from Krish)
OLLAMA_URL=http://localhost:11434
# Exact tag Krish pulled, e.g. dolphin3 or dolphin3:latest
OLLAMA_MODEL=dolphin3

# --- Right panel: Gemini ---
# aistudio.google.com -> Get API key -> Create API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Comma-separated backups, tried in order if the main model is overloaded (503) or silent
GEMINI_FALLBACK_MODELS=

# --- Optional: override system prompts (leave unset for defaults in backend/main.py) ---
# UNCENSORED_SYSTEM_PROMPT=
# GUARDED_SYSTEM_PROMPT=
